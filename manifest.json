{
  "manifest_version": 3,
  "name": "续聊 · AI 会话工作台",
  "version": "0.3.0",
  "description": "从聊天库随机抽取连贯话题，在 ChatGPT 网页中按轮次、串行或并行进行对话。",
  "permissions": ["storage", "unlimitedStorage", "alarms", "activeTab", "scripting", "debugger"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "显示 / 隐藏续聊悬浮菜单", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["content/overlay.js", "content/adapter-chatgpt.js", "content/runner.js"],
    "run_at": "document_idle"
  }],
  "options_page": "ui/index.html",
  "minimum_chrome_version": "120",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
